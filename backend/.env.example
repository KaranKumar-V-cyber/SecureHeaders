# Backend Environment Variables

# Database
DATABASE_URL=sqlite:///./scan_history.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/headersent inel

# API Configuration
API_TITLE=HeaderSentinel API
API_VERSION=1.0.0
API_DESCRIPTION=Web Security Header Analyzer

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# SSRF Protection
SSRF_ALLOW_PRIVATE=false
SSRF_TIMEOUT=10
SSRF_MAX_REDIRECTS=5
SSRF_MAX_RESPONSE_SIZE=10485760
SSRF_ALLOWLIST=

# Security
SECRET_KEY=change-this-in-production

# Logging
LOG_LEVEL=INFO
